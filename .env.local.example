NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for VL wipe/import (auth.admin create/delete) — also preferred for Storage / directors
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Directors Excel import (after migration 040_directors_remark.sql):
#   node scripts/import-directors.mjs --file "C:/Webapp/ConED_DB/Directors.xlsx" --wipe
#   node scripts/import-directors.mjs --file "C:/Webapp/ConED_DB/Directors.xlsx" --wipe --dry-run
# Rules: blank gender → NULL; dedupe by name_prefix+full_name+phone; assign school_id.
#
# VL Excel import (after migration 041_volunteer_profiles.sql):
#   node scripts/import-volunteers.mjs --file "C:/Webapp/ConED_DB/VL_Role_Upload.xlsx" --wipe
#   node scripts/import-volunteers.mjs --file "C:/Webapp/ConED_DB/VL_Role_Upload.xlsx" --wipe --dry-run
#
# Scholarship Excel import (migration 032 already applied):
#   node scripts/import-scholarship.mjs --students "C:/Webapp/ConED_DB/Scholarship_student.xlsx" --family "C:/Webapp/ConED_DB/scholarship_family_members.xlsx" --wipe

# UAT: operational data from Supabase only (schedule / reports / tickets / users).
# Default is ON when unset. Set to 0 only for offline cookie demos.
# CONED_UAT_DB_ONLY=1
#
# Admin "create user" needs migration 016_create_coned_user_rpc.sql in Supabase.

# Storage buckets (run migration 010): school-covers, report-images
# Optional: set to 1 only if Image Transformation is enabled on the Supabase project
# NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORM=1

# Local only — do NOT set on Vercel
# CONED_RELAX_TLS=1
