NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# UAT: operational data from Supabase only (schedule / reports / tickets / users).
# Default is ON when unset. Set to 0 only for offline cookie demos.
# CONED_UAT_DB_ONLY=1
#
# Admin "create user" needs migration 016_create_coned_user_rpc.sql in Supabase.

# Storage buckets (run migration 010): school-covers, report-images
# Optional: set to 1 only if Image Transformation is enabled on the Supabase project
# NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORM=1

# Local only — do NOT set on Vercel
# CONED_RELAX_TLS=1
